{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flowshift",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "flowshift.atto-hub.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flowshift-db",
      "database_id": "bd716694-8121-4008-bf1b-3561a937591c",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "TOKEN_KEY_VERSION": "v1"
  },
  "secrets": {
    "required": ["DEEPSEEK_API_KEY", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "TOKEN_ENCRYPTION_KEY"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
