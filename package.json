{
  "name": "flowshift",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-local-secret.mjs && wrangler d1 migrations apply DB --local",
    "dev": "vite",
    "prebuild": "node scripts/clear-local-secret.mjs",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.node.json && vite build && node scripts/strip-build-secrets.mjs",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-local.mjs",
    "smoke:http": "node scripts/smoke-local.mjs --skip-ai",
    "check": "npm run workgroups:check && npm run interview:check && npm run projects:check && npm run decomposition:check && npm run drafts:check",
    "secret:check": "node scripts/check-repository-secrets.mjs",
    "workgroups:check": "node --experimental-strip-types scripts/check-work-groups.mjs",
    "interview:check": "node --experimental-strip-types scripts/check-interview-meaning.mjs",
    "projects:check": "node --experimental-strip-types scripts/check-project-lifecycle.mjs",
    "decomposition:check": "node --experimental-strip-types scripts/check-work-decomposition.mjs",
    "drafts:check": "node --experimental-strip-types scripts/check-session-drafts.mjs",
    "ai:check": "node --experimental-transform-types scripts/check-deepseek-flow.mjs",
    "types": "wrangler types worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cf:dry-run": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.1",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.1",
    "@cloudflare/workers-types": "^5.20260809.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wrangler": "^4.120.0"
  }
}
